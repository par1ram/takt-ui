{
  "name": "ui-library",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "bun run registry:build && next dev",
    "build": "bun run registry:build && next build",
    "start": "next start",
    "lint": "eslint",
    "registry:build": "shadcn build && bun scripts/build-locales.ts && bun scripts/build-agent-index.ts",
    "registry:check": "node scripts/check-consumer.mjs",
    "motion:sync": "bun scripts/motion-references.mjs",
    "motion:review": "bun scripts/review-motion.mjs",
    "motion:verify": "bun scripts/motion-references.mjs --verify",
    "test": "bun test --isolate tests/unit tests/components",
    "test:unit": "bun test --isolate tests/unit",
    "test:components": "bun test --isolate tests/components",
    "test:coverage": "bun test --isolate --coverage --coverage-reporter=text --coverage-reporter=lcov tests/unit tests/components",
    "test:contracts": "bun test tests/contracts",
    "test:integration": "bun run test:contracts && bun scripts/review-motion-host.mjs",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test accessibility.pw.mjs",
    "test:all": "bun run test:coverage && bun run lint && bun run build && bun run test:integration && bun run test:e2e"
  },
  "dependencies": {
    "@stripe/react-stripe-js": "^7.1.0",
    "@stripe/stripe-js": "^10.3.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "lucide-react": "^1.75.0",
    "motion": "^14.14.0",
    "next": "16.4.6",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "3.8.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^21.0.4",
    "@modelcontextprotocol/client": "^2.4.0",
    "@tailwindcss/turbopack": "4.3.3",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "axe-core": "^4.14.1",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "playwright": "^1.65.1",
    "shadcn": "^4.23.0",
    "tailwindcss": "4.3.3",
    "typescript": "^5"
  },
  "packageManager": "bun@1.3.14",
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
